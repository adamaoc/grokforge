# GrokForge — copy to `.env` in the project root (never commit real keys).
# Loaded in the Electron **main** process only (`import 'dotenv/config'` in `src/main/main.ts`).

# xAI Grok API key (required for live chat streaming). See https://docs.x.ai/
XAI_API_KEY=

# Optional alias if you prefer a GrokForge-specific name:
# GROKFORGE_XAI_API_KEY=

# Optional: override chat completions URL (default https://api.x.ai/v1/chat/completions)
# GROKFORGE_XAI_CHAT_COMPLETIONS_URL=

# Optional: Grok Voice Agent WebSocket base URL (default wss://api.x.ai/v1/realtime). Same API key as chat.
# GROKFORGE_XAI_REALTIME_URL=

# Optional: xAI TTS URL for read-aloud (default https://api.x.ai/v1/tts). Same API key as chat.
# GROKFORGE_XAI_TTS_URL=
