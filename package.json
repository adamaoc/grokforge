{
  "name": "grokforge",
  "version": "0.1.0",
  "private": true,
  "description": "GrokForge – The Grok-native, voice-first multi-root coding agent for real developers",
  "author": "Adam Moore",
  "repository": {
    "type": "git",
    "url": "https://github.com/adamaoc/grokforge.git"
  },
  "bugs": {
    "url": "https://github.com/adamaoc/grokforge/issues"
  },
  "homepage": "https://github.com/adamaoc/grokforge#readme",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:harness": "vitest run src/harness/**/__tests__/*.test.ts",
    "test:e2e": "npm run build && vitest run -c vitest.e2e.config.ts",
    "test:e2e:ui": "npm run build && playwright test -c playwright.e2e.config.ts",
    "test:e2e:ui:headed": "npm run build && playwright test -c playwright.e2e.config.ts --headed",

    "cleanup:audit": "node scripts/cleanup-audit.mjs",
    "ensure:node-pty": "node scripts/ensure-node-pty-executable.mjs",
    "postinstall": "node scripts/ensure-node-pty-executable.mjs",
    "dist": "npm run build && electron-builder --mac",
    "dist:dir": "npm run build && electron-builder --mac dir"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^11.3.0",
    "ignore": "^7.0.5",
    "lucide-react": "^0.454.0",
    "minimatch": "^10.2.5",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.18.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "app.grokforge.desktop",
    "productName": "GrokForge",
    "copyright": "Copyright © 2026 Adam Moore",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "assets/GF-logo.png",
    "files": [
      "dist/**/*",
      "package.json",
      "assets/GF-logo.png"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": null
  }
}
